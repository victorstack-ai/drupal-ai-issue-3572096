<?php

/**
 * @file
 * The AI Logging module.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter().
 */
function ai_logging_form_ai_settings_alter(&$form, FormStateInterface $form_state) {
  $config = \Drupal::config('ai_logging.settings');
  $form['prompt_logging'] = [
    '#type' => 'checkbox',
    '#title' => t('Log prompts'),
    '#description' => t('Log all or selective prompts and responses in the database.'),
    '#default_value' => $config->get('prompt_logging'),
  ];

  $form['prompt_logging_output'] = [
    '#type' => 'checkbox',
    '#title' => t('Log prompt output'),
    '#description' => t('Also log the output of the AI requests.'),
    '#default_value' => $config->get('prompt_logging_output'),
  ];

  $form['prompt_logging_tags'] = [
    '#type' => 'textfield',
    '#title' => t('Prompt Tags'),
    '#description' => t('Log prompts and responses with these tags in the database. Separate tags with commas.'),
    '#default_value' => $config->get('prompt_logging_tags'),
    '#states' => [
      'visible' => [
        ':input[name="prompt_logging"]' => ['checked' => TRUE],
      ],
    ],
  ];

  // Add a submit handler to save the configuration.
  $form['#submit'][] = 'ai_logging_settings_submit';
}

/**
 * Submit handler for the AI Logging settings form.
 */
function ai_logging_settings_submit($form, FormStateInterface $form_state) {
  $config = \Drupal::service('config.factory')->getEditable('ai_logging.settings');
  $config->set('prompt_logging', $form_state->getValue('prompt_logging'))
    ->set('prompt_logging_tags', $form_state->getValue('prompt_logging_tags'))
    ->set('prompt_logging_output', $form_state->getValue('prompt_logging_output'))
    ->save();
}
